# =============================================================================
# 酒店经营数据自动化系统 · 段2 企业微信推送 —— 配置样例
# 用法:cp .env.example .env  然后按需修改
#
# 🚫 时刻表不进 .env —— 全部写在 src/hoteldata/jobs.py 的任务注册表里
#    (@task(cron=...));.env 只保留 *_ENABLED 开关。
#
#    段1 曾把 PATROL_TIME / SCREENSHOT_TIME / BACKUP_TIME / CLEANUP_TIME
#    临时留在 .env(标注 [过渡]);段1 M6 收尾时已全部清除,现在**三段一致**。
#    旧系统的病根是「时刻表散在 4 处」(.env + scheduler.py +
#    report_schedule.json + push_rotation.json),改一处漏三处 —— 不能重演。
# =============================================================================

# ---- 通用 ----
TZ=Asia/Shanghai
DEBUG=0

# ---- 数据库(★ 必填;必须 postgresql+asyncpg 方言)----
# 本机 PG 由 docker compose up -d pg 提供(端口 5433,避免与本机其它 PG 冲突)
DB_URL=postgresql+asyncpg://hoteldata:hoteldata@127.0.0.1:5433/hoteldata
DB_ECHO=0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_S=30
DB_STATEMENT_TIMEOUT_MS=60000

# ---- Web ----
HOST=127.0.0.1
PORT=8000

# ---- 提取 ----
COLLECT_ROTATION_ENABLED=1
COLLECT_ALL_WINDOWS=0

# ---- 风控 / 限频(★ 红线,不要调低)----
RATE_LIMIT_ENABLED=1
RATE_LIMIT_INTERVAL_S=0.6
MAX_CONCURRENT_ACCOUNTS=4
API_TIMEOUT_S=20
RETRY_TIMES=3
RETRY_BACKOFF_S=2,8,30

# ---- 浏览器 ----
HEADLESS=0
MAX_CONTEXTS=4
CHROME_CDP_URL=
CDP_CONNECT_TIMEOUT_S=15
BROWSER_CHANNEL=chrome
NAV_TIMEOUT_S=60
PAGE_READY_TIMEOUT_S=120
CHART_READY_WAIT_S=8
BROWSER_VIEWPORT=1600x1000
BROWSER_LOCALE=zh-CN
BROWSER_SLOW_MO_MS=0
# BROWSER_USER_AGENT=  # 留空用内置 Chrome/125 UA

# ---- 登录 ----
LOGIN_MAX_AGE_DAYS=20
LOGIN_RENEW_ENABLED=1
MANUAL_LOGIN_WAIT_S=600
LOGIN_CHECK_TIMEOUT_S=45

# ---- 截图 ----
SCREENSHOT_ENABLED=1
SCREENSHOT_JPEG_QUALITY=70
SCREENSHOT_MAX_BYTES=102400

# ---- 运维 ----
BACKUP_RETENTION_DAYS=7
DATA_RETENTION_DAYS=30
SCREENSHOT_RETENTION_DAYS=90
DISK_MIN_FREE_GB=20

# ---- 视觉模型(★ 默认关闭)----
# 🔴 启用前必须取得客户书面授权:GLM-4.6V 是第三方云服务,
#    调用 = 把客户酒店经营数据截图外发到智谱服务器。
VISION_ENABLED=0
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.6v
VISION_DAILY_CALL_LIMIT=200

# =============================================================================
# 段2 · 企业微信推送
# =============================================================================

# ---- 机器人(★ 协议常量,A1 级遗产逐字继承 —— 不要改默认值)----
AIBOT_ENABLED=1
AIBOT_WS_URL=wss://openws.work.weixin.qq.com
AIBOT_SUBSCRIBE_TIMEOUT_S=10
AIBOT_HEARTBEAT_S=30
AIBOT_HEARTBEAT_TIMEOUT_S=6
AIBOT_MAX_MISS=2             # ★ 连丢 2 次才判死(丢 1 次不重连)
AIBOT_ACK_TIMEOUT_S=15
AIBOT_RECV_TIMEOUT_S=20
AIBOT_CHUNK_SIZE=524288      # 512KB/片
AIBOT_MAX_CHUNKS=100         # >100 片报错
AIBOT_CAPACITY_PER_BOT=10    # 仅告警,不硬拦
AIBOT_HEALTH_INTERVAL_S=300

# ---- 推送 ----
PUSH_MIN_INTERVAL_S=2.0          # ★ 机器人级限频(修 D5);群级另有二次节流
PUSH_GROUP_MIN_INTERVAL_S=2.0    # 群级二次节流
PUSH_RETRY_TIMES=3               # 共 4 次尝试
PUSH_RETRY_BACKOFF_S=2,8,30
PUSH_MAX_IMAGES=5                # 每群每次附图上限
PUSH_MERGE_LIMIT_CHARS=3500      # 单条消息上限,超限按店对半拆 ≤2 条
# ★ 管理群白名单:11 条管理群命令只在这里生效;留空 = 一律拒绝(不是放行)
MANAGE_CHATIDS=
# 运维告警群(自检 / 机器人掉线);留空则告警目标只剩 MANAGE_CHATIDS
OPS_CHATID=

# ---- 预警 ----
ALERT_ENABLED=1
# ★ 名义时刻(业务语义层)。调度层的 cron(09:04/14:34/19:04)在 jobs.py 里,
#   引擎会把实际时刻「映回」这里的名义时刻去匹配规则 check_times。
ALERT_ROOM_SLOTS=09:00,14:30,19:00
ALERT_DATA_SLOTS=09:00

# ---- 点评 ----
REVIEW_SUGGEST_ENABLED=1
REVIEW_ANALYSIS_ENABLED=1
# ★ 自动回复仍需 config/review_sources.json 的 submit.ready 才真正放行;
#   该值当前必然为 false(提交接口从未被捕获)→ 走"未就绪 → 人工队列"。
REVIEW_AUTO_ENABLED=1
REVIEW_REALTIME_ENABLED=1
REVIEW_REALTIME_INTERVAL_MIN=60

# ---- 违约实时 / 自检推送 ----
OPS_SELFCHECK_PUSH=1
VIOLATION_REALTIME_ENABLED=1
VIOLATION_INTERVAL_MIN=60

# =============================================================================
# 后台(Phase 3;总纲 §7.8)
# =============================================================================
#
# ★ 后台是**服务端渲染**(Jinja2 + 一份手写 CSS),不引入前端构建链。
# ★ 范围:账号/机器人/酒店/群绑定/比价酒店增删 + 统一口令登录 + 操作审计。
#   **明确不做**:角色区分、权限树、API 鉴权细化。

# 后台总开关(0 = /admin 全部 404,只留 /healthz 与 /status)
ADMIN_ENABLED=1
# ★ 统一口令的 PBKDF2 哈希(**不是明文、不是明文摘要**)。
#   生成:`hoteldata admin passwd --set <新口令>`(会自动写入本文件)
#   **留空 = 后台拒绝一切登录**(安全默认,不是放行;与"未配置 MANAGE_CHATIDS
#   时管理群命令一律拒绝"同一条纪律)
ADMIN_PASSWORD_HASH=
# 会话 cookie 签名密钥;留空则退回 config/secret.key(段1 的 Fernet 密钥)
# 留空也能用;两条都没有时会用**进程内临时密钥**并告警(重启即掉线,但不会退化成"没有签名")
ADMIN_SESSION_SECRET=
# 会话有效期(小时)
ADMIN_SESSION_HOURS=12
# ★ 是否允许非本机访问。默认 0 = 只允许 127.0.0.1/::1
#   ("监听 127.0.0.1"只挡住网络层,所以在**应用层**再挡一次)
ADMIN_ALLOW_REMOTE=0

# =============================================================================
# 段3 · 比价
# =============================================================================
#
# ★ 时刻表**不进这里** —— compare.batch / compare.collect / compare.push
#   的 cron 全部写在 src/hoteldata/jobs.py 的任务注册表里(总纲 §7.5「唯一来源」)。
#   所以旧系统的 HOTEL_BATCH_TIME / PRICE_COLLECT_TIMES / PRICE_PUSH_TIMES
#   **一个都不迁移**。

COMPARE_ENABLED=1
# 参与平台,逗号分隔。★ 写未注册的名字会**直接报错**(不是静默少跑一个平台)
HOTEL_PLATFORMS=ctrip,meituan
# 锚点附近取几家(--nearby 可覆盖)
HOTEL_NEARBY_COUNT=3
# 每个平台保留/展示几条报价(旧 PRICE_ROOM_COUNT 的**真正含义**:
#   旧系统把它当房型数用,但列表页只有「起价」,并没有房型粒度)
HOTEL_QUOTE_COUNT=3
# ★ 排序模式:geo=按距离升序(默认,修 D13)/ platform=平台「附近酒店」原始顺序。
#   拼错会**启动即失败** —— 旧系统拼错会静默退化,用户以为在看"距离最近"
HOTEL_RANK_MODE=geo
# ★ 比价专用 headless。
#   计划书原本还有 HOTEL_BATCH_HEADLESS(批量无头),但 headless 是 **Chromium
#   进程级**参数(infra/browser.py 的 launch(headless=...)),一个浏览器池只有一个值,
#   「交互有头 + 批量无头」在同一进程内**无法共存** → 段3 只保留这一个开关。
HOTEL_HEADLESS=0
# 默认城市(比价目标清单里行内的 city 优先)
HOTEL_CITY=
# 坐标缺失时逐个打开候选页的上限(旧 HOTEL_TOP_N_OPEN=6,旧系统零引用)
HOTEL_COORD_FALLBACK_MAX=6
# 单店双平台比价超时(秒)—— 计划书 §2.3 的性能目标
HOTEL_COMPARE_TIMEOUT_S=90
# 批量跑完推汇总(旧 HOTEL_BATCH_PUSH,默认 0 = 不推)
HOTEL_BATCH_PUSH=0
# 演示数据酒店名前缀(与段1/段2 的 verify2- 同一纪律,便于识别与清理)
COMPARE_DEMO_PREFIX=验收3-

# ---- 视觉兜底(段3)----
# 🔴 VISION_ENABLED=1 前**必须取得客户书面授权**:
#    调用 = 把客户酒店数据截图**外发到智谱服务器**。
#    默认 0 时**零 HTTP、零 SDK 导入**(结构性保证)。
VISION_ENABLED=0
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.6v
VISION_DAILY_CALL_LIMIT=200
# ★ 视觉价与 DOM 价偏差超过此比例 → 标「待人工确认」,**不静默采用**
VISION_PRICE_TOLERANCE=0.2

