{
  "_comment": "计划书③ 报告节奏配置(v2.0,纯数据模式;2026-08-25 按用户决定移除 AI 分析)。桶: daily=每日/monday=周一/month1=每月1号/realtime=实时(问答触发)。窗口:① §19.1 中文七窗口 + 未来30天(模块9)+ 未来14天(模块15,以②实测校准)。mode: data(内容=数据模板直接渲染,不自带 LLM 调用)。daily_except_monday=true 表示周一让位给周报(服务概览)。【2026-08-25 恢复】服务概览日报/周报 2 项(以模块级每日固定采集恢复,数据源=module_records;周报=近 7 天按字段 sum/avg/last 聚合,见 item.aggregate)。",
  "defaults": {
    "push_time": "09:00"
  },
  "items": [
    {
      "id": "svc_daily",
      "name": "服务概览",
      "page": "经营报告",
      "windows": {
        "daily": [
          "昨日"
        ]
      },
      "mode": "data",
      "daily_except_monday": true
    },
    {
      "id": "svc_weekly",
      "name": "服务概览(周报)",
      "page": "经营报告",
      "windows": {
        "monday": [
          "昨日"
        ]
      },
      "mode": "data",
      "aggregate": {
        "days": 7,
        "sum": [
          "交易额(元)",
          "已售间夜",
          "订单量",
          "今日访客量",
          "今日订单量",
          "竞争订单量",
          "竞争交易额(元)"
        ],
        "avg": [
          "出租率(%)",
          "出租率(市场,%)",
          "平均房价(元)",
          "竞争度(%)",
          "热度",
          "服务分",
          "收藏数",
          "5分钟回复率(%)",
          "IM评分"
        ],
        "last": [
          "携程评分",
          "经营综合得分",
          "得分等级"
        ]
      }
    },
